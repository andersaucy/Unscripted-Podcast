<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="9.0" ExtensionBundleId="com.unscripted.podcast" ExtensionBundleVersion="1.3.0"
    ExtensionBundleName="Unscripted-Podcast" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <ExtensionList>
        <Extension Id="com.unscripted.podcast.panel" Version="1.3.0" />
    </ExtensionList>
    <ExecutionEnvironment>
        <HostList>
            <!-- Premiere Pro. Range covers 2024 (24.x) through 2026 (26.x) and beyond. -->
            <Host Name="PPRO" Version="[24.0,99.9]" />
        </HostList>
        <LocaleList>
            <Locale Code="All" />
        </LocaleList>
        <RequiredRuntimeList>
            <RequiredRuntime Name="CSXS" Version="9.0" />
        </RequiredRuntimeList>
    </ExecutionEnvironment>
    <DispatchInfoList>
        <Extension Id="com.unscripted.podcast.panel">
            <DispatchInfo>
                <Resources>
                    <MainPath>./client/index.html</MainPath>
                    <ScriptPath>./host/index.jsx</ScriptPath>
                    <CEFCommandLine>
                        <Parameter>--allow-file-access</Parameter>
                        <Parameter>--allow-file-access-from-files</Parameter>
                    </CEFCommandLine>
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>Unscripted-Podcast</Menu>
                    <Geometry>
                        <Size>
                            <Height>660</Height>
                            <Width>320</Width>
                        </Size>
                        <MinSize>
                            <Height>430</Height>
                            <Width>240</Width>
                        </MinSize>
                        <MaxSize>
                            <Height>1200</Height>
                            <Width>800</Width>
                        </MaxSize>
                    </Geometry>
                    <Icons />
                </UI>
            </DispatchInfo>
        </Extension>
    </DispatchInfoList>
</ExtensionManifest>
